{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cart-trace/care_state_interval.schema.json",
  "title": "CART-TRACE Care-State Interval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id",
    "interval_id",
    "state",
    "start_timestamp",
    "start_relative_hours",
    "source_type",
    "source_record_ids",
    "mapping_method",
    "uncertain"
  ],
  "properties": {
    "episode_id": {"type": "string", "minLength": 1},
    "interval_id": {"type": "string", "minLength": 1},
    "state": {
      "type": "string",
      "enum": [
        "outpatient",
        "emergency",
        "routine_inpatient",
        "intermediate_care",
        "intensive_care",
        "discharged",
        "unknown"
      ]
    },
    "start_timestamp": {"type": "string", "format": "date-time"},
    "end_timestamp": {"type": ["string", "null"], "format": "date-time"},
    "start_relative_hours": {
      "type": "number",
      "description": "Continuous elapsed hours from the CAR T infusion timestamp."
    },
    "end_relative_hours": {"type": ["number", "null"]},
    "source_type": {"type": "string", "minLength": 1},
    "source_record_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "mapping_method": {"type": "string", "minLength": 1},
    "provenance_id": {"type": ["string", "null"]},
    "uncertain": {"type": "boolean", "default": false},
    "uncertainty_reason": {"type": ["string", "null"]},
    "open_end_reason": {"type": ["string", "null"]}
  }
}
